# Copy to `.env.local` for local development. `.env.local` is git-ignored:
# never commit a real host, username or password.
#
# 1. Optional: bake a default API base URL into the app.
#    Leave empty to force the connect screen (recommended for public builds).
VITE_API_BASE_DEFAULT=

# 2. Public path the app is served from. GitHub Pages project sites use /<repo>/.
VITE_BASE=/

# 3. Language the installable app declares to the operating system. The interface itself
#    follows the browser; this only labels the installed icon and manifest.
VITE_APP_LANG=zh-CN

# 4. Optional dev-only proxy: lets `npm run dev` reach an API whose CORS list
#    does not include http://localhost:5173. Point VITE_API_BASE_DEFAULT at
#    /ft-api and set this to the origin that serves /api/v1.
# FT_DEV_PROXY_TARGET=https://your-bot.example.com
